# Byte-compiled / optimized / URL overrides
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# Virtual environments
venv/
.venv/
env/

# Daten: Rohdaten und Zwischenergebnisse werden vom Code erzeugt, nicht committet
data/raw/**
data/interim/**
data/processed/*.parquet
!data/**/.gitkeep

# Environment variables & keys
.env
.env.*
!.env.example

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log
